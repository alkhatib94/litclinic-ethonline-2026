{
  "name": "litclinic-ethonline-2026",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*"
  ],
  "scripts": {
    "check": "bun run type-check && bun test && bun run secret:scan",
    "demo:agent-plan": "bun run scripts/demo-agent-plan.ts",
    "demo:context": "bun run scripts/demo-context.ts",
    "demo:world": "bun run scripts/demo-world.ts",
    "demo:world:mock": "bun run scripts/demo-world-mock.ts",
    "dev:api": "bun --watch apps/api/src/server.ts",
    "test": "vitest run",
    "typecheck": "bun run type-check",
    "type-check": "bunx tsc --project tsconfig.json --noEmit",
    "secret:scan": "node scripts/scan-secrets.mjs",
    "world:address": "bun run scripts/world-address.ts",
    "world:status": "bun run scripts/world-status.ts",
    "demo:world:sandbox": "bun run scripts/demo-world-sandbox.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
