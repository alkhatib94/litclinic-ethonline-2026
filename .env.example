# Public URL of the ETHOnline extension.
APP_BASE_URL=

# Approved LitClinic API boundary. Use a scoped development endpoint and token.
LITCLINIC_API_BASE_URL=
LITCLINIC_API_ACCESS_TOKEN=

# Secret used to verify LitClinic webhook signatures.
LITCLINIC_WEBHOOK_SIGNING_SECRET=

# Target EVM network and RPC endpoint.
EVM_CHAIN_ID=
EVM_RPC_URL=

# Credential for the AI provider selected during the hackathon.
AI_PROVIDER_API_KEY=

# Optional partner adapter endpoint and scoped credential.
PARTNER_API_BASE_URL=
PARTNER_API_KEY=
