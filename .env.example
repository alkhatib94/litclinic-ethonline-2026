# Context provider mode. Supported values are mock and remote.
LITCLINIC_CONTEXT_MODE=

# Base URL for the approved private LitClinic HTTPS API boundary.
LITCLINIC_API_URL=

# Scoped service-to-service bearer token for the private boundary.
LITCLINIC_SERVICE_TOKEN=

# Relative upstream path with one wallet placeholder, for example a reviewed path containing {wallet}.
LITCLINIC_CONTEXT_ENDPOINT=

# The Graph Network gateway API key for authenticated live subgraph queries.
THE_GRAPH_API_KEY=

# Optional HTTPS gateway base URL. Blank uses the official gateway in code.
THE_GRAPH_GATEWAY_URL=

# Optional subgraph ID. Blank uses the reviewed Uniswap V3 Ethereum subgraph ID in code.
THE_GRAPH_SUBGRAPH_ID=

# Local API listener port.
PORT=
